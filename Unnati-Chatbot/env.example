# ============================================
# UNNATI CHATBOT - ENVIRONMENT VARIABLES
# ============================================

# MONGODB CONNECTION
MONGODB_HOST=your-mongodb-host
MONGODB_PORT=27017
MONGODB_USER=your-username
MONGODB_PASSWORD=your-password
MONGODB_DB=AIChatbot

# GOOGLE GEMINI API
GOOGLE_GEMINI_API_KEY=your-google-gemini-key

# GROQ API
GROQ_API_KEY=your-groq-api-key

# PERPLEXITY API
PERPLEXITY_API_KEY=your-perplexity-key
PERPLEXITY_MODEL=sonar-pro

# PINECONE VECTOR DB
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX_NAME=unnati-faq

# GMAIL OAUTH2
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_RECIPIENT=contact@vidhyarthimitra.org

# N8N CONFIGURATION
N8N_HOST=your-n8n-instance.com
N8N_PORT=5678
N8N_WEBHOOK_URL=https://your-domain.com/webhook/unnati-chat

# LOGGING
LOG_LEVEL=info
DEBUG=false

# RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
